# BorrowCircles Server Environment Variables
# Copy this file to .env and update values

# Server Configuration
PORT=5100
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/borrowcircles

# JWT Configuration
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Password Hashing
BCRYPT_ROUNDS=12

# Client URL (for CORS)
CLIENT_URL=http://localhost:5180
